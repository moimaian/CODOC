#!/bin/bash
# /usr/bin/codoc — instalado pelo pacote .deb.
#
# Roda como o usuário comum que clicou no menu (não como root). Só faz duas
# coisas:
#   1) sincroniza o código instalado pelo pacote em /opt/codoc para
#      $HOME/CODOC, sem nunca tocar nas pastas de trabalho do usuário (PROJECTS,
#      BASE...) nem em caches de bytecode;
#   2) abre o CODOC. Se o venv $HOME/.venv/CODOC já existe, usa o python dele
#      direto (como o .desktop criado pelo próprio CODOC); se não existe,
#      deixa o CODOC.py criar o venv na primeira execução (ver
#      MODULES/module_requirements.py:bootstrap_pyqt5 / MODULES/splash_screen.py).
set -euo pipefail

SRC_DIR="/opt/codoc"
APP_DIR="${HOME}/CODOC"

if [ ! -d "$SRC_DIR" ]; then
    echo "codoc: $SRC_DIR não encontrado — o pacote está corrompido ou foi removido." >&2
    exit 1
fi

mkdir -p "$APP_DIR"

# Pastas do usuário que nunca são sobrescritas/removidas pela sincronização.
USER_DIRS=(PROJECTS BASE TEST BENCHMARK)

if command -v rsync >/dev/null 2>&1; then
    EXCLUDES=()
    for d in "${USER_DIRS[@]}"; do EXCLUDES+=("--exclude=/$d/"); done
    rsync -a "${EXCLUDES[@]}" \
        --exclude='__pycache__/' \
        --exclude='*.pyc' \
        "$SRC_DIR"/ "$APP_DIR"/
else
    # Fallback sem rsync: copia tudo exceto as pastas de trabalho do usuário.
    for item in "$SRC_DIR"/*; do
        name="$(basename "$item")"
        skip=0
        for d in "${USER_DIRS[@]}"; do [ "$name" = "$d" ] && skip=1; done
        [ "$skip" = 1 ] && continue
        cp -rf "$item" "$APP_DIR"/
    done
fi

# A PRIMEIRA execução precisa criar o venv e pergunta "Continue? [S/n]" via input(). O
# .desktop usa Terminal=false (o CODOC abre sem janela de terminal; o menu Help > Terminal abre
# um quando o usuário quiser), então, sem venv e sem terminal, o launcher reabre a si mesmo
# dentro de um emulador de terminal só para essa configuração inicial.
VENV_PY="${HOME}/.venv/CODOC/bin/python"
if [ ! -x "$VENV_PY" ] && [ ! -t 0 ] && [ -z "${CODOC_SETUP_TERMINAL:-}" ]; then
    export CODOC_SETUP_TERMINAL=1
    SELF="$(readlink -f "$0")"
    if command -v gnome-terminal >/dev/null 2>&1; then
        exec gnome-terminal --title="CODOC - Setup" -- "$SELF" "$@"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        exec x-terminal-emulator -e "$SELF"
    elif command -v xterm >/dev/null 2>&1; then
        exec xterm -T "CODOC - Setup" -e "$SELF" "$@"
    fi
fi

if [ -x "$VENV_PY" ]; then
    # Já dentro do venv: o CODOC.py não pergunta nada nem se re-executa.
    exec env PYTHONNOUSERSITE=1 "$VENV_PY" "$APP_DIR/CODOC.py" "$@"
fi
exec python3 "$APP_DIR/CODOC.py" "$@"
